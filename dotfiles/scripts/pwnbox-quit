#!/usr/bin/env bash
# ALT + SHIFT + Q: quit the program that owns the focused window, not only the
# window. Closing a window leaves apps like Discord, Spotify and Telegram running
# in the background; this ends them.
#
# The program is asked to quit first (SIGTERM), which lets a browser save its
# tabs. If it is still there after five seconds it is stopped for good.
# Closing just the window is ALT + Z.
set -u

info="$(hyprctl activewindow -j 2>/dev/null)" || exit 0
pid="$(printf '%s' "$info" | jq -r '.pid // empty' 2>/dev/null)" || exit 0
case "$pid" in '' | *[!0-9]*) exit 0 ;; esac
[ "$pid" -gt 1 ] || exit 0

# Never take the desktop down with the window: the compositor, the bar and the
# X11 bridge only get their window closed.
comm="$(cat "/proc/$pid/comm" 2>/dev/null)" || exit 0
case "$comm" in
    Hyprland | .Hyprland-wrapp | quickshell | .quickshell-wra | Xwayland | systemd | sh | bash | zsh | fish)
        hyprctl dispatch killactive >/dev/null 2>&1
        exit 0
        ;;
esac

kill -TERM "$pid" 2>/dev/null || exit 0
for _ in $(seq 1 25); do
    kill -0 "$pid" 2>/dev/null || exit 0
    sleep 0.2
done
pkill -KILL -P "$pid" 2>/dev/null || true
kill -KILL "$pid" 2>/dev/null || true
