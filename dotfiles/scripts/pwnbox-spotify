#!/usr/bin/env bash
set -euo pipefail

cfg_dir="${XDG_CONFIG_HOME:-$HOME/.config}/spicetify"
theme_dir="$cfg_dir/Themes/pwnbox"
base_css="$theme_dir/user-base.css"
user_css="$theme_dir/user.css"
data_home="${XDG_DATA_HOME:-$HOME/.local/share}"
dest_root="$data_home/pwnbox/spotify"
dest_dir="$dest_root/share/spotify"
prefs="$HOME/.config/spotify/prefs"
theme_js="$HOME/.config/quickshell/Theme.js"
cache="${XDG_CACHE_HOME:-$HOME/.cache}/pwnbox/theme"
live_js="$HOME/.scripts/pwnbox-spotify-live.mjs"

debug_port=9222
debug_flags=("--remote-debugging-port=$debug_port" "--remote-allow-origins=*")

have() { command -v "$1" >/dev/null 2>&1; }

cache_value() {
    local file="$1" fallback="$2" v
    v="$(cat "$cache/$file" 2>/dev/null || true)"
    [ -n "$v" ] && printf '%s' "$v" || printf '%s' "$fallback"
}

src_spotify_dir() {
    local bin dir
    while IFS= read -r bin; do
        [ -n "$bin" ] || continue
        case "$bin" in
            "$HOME"/.local/*) continue ;;
        esac
        bin="$(readlink -f "$bin")"
        case "$bin" in
            "$HOME"/.local/*) continue ;;
        esac
        [ -f "$bin" ] || continue
        dir="$(dirname "$bin")"
        [ -x "$dir/spotify" ] || continue
        [ -e "$dir/.spotify-wrapped" ] || continue
        printf '%s' "$dir"
        return 0
    done < <(type -aP spotify 2>/dev/null || true)
    return 1
}

theme_var() {
    local key="$1" fallback="$2" v
    v="$(sed -nE "s/^var ${key}[[:space:]]*=[[:space:]]*\"#?([0-9a-fA-F]{6})\".*/\1/p" \
        "$theme_js" 2>/dev/null | head -1)"
    [ -n "$v" ] && printf '%s' "$v" || printf '%s' "$fallback"
}

ensure_copy() {
    local src_dir src_pkg stamp current
    src_dir="$(src_spotify_dir)" || {
        echo "pwnbox-spotify: could not find the spotify binary" >&2
        return 1
    }
    case "$src_dir" in
        /nix/store/*) ;;
        *)
            echo "pwnbox-spotify: refusing suspicious spotify path: $src_dir" >&2
            return 1
            ;;
    esac
    src_pkg="$(dirname "$(dirname "$src_dir")")"
    case "$src_pkg" in
        /nix/store/*-spotify*) ;;
        *)
            echo "pwnbox-spotify: refusing suspicious spotify package: $src_pkg" >&2
            return 1
            ;;
    esac
    [ -x "$src_dir/spotify" ] && [ -e "$src_dir/.spotify-wrapped" ] || {
        echo "pwnbox-spotify: $src_dir does not look like a Spotify install" >&2
        return 1
    }
    stamp="$dest_root/.source"

    current="$(cat "$stamp" 2>/dev/null || true)"
    if [ "$current" = "$src_pkg" ] && [ -x "$dest_dir/spotify" ]; then
        return 0
    fi

    rm -rf "$dest_root"
    mkdir -p "$dest_dir"
    cp -a "$src_dir/." "$dest_dir/"
    chmod -R u+w "$dest_dir"

    sed -i "s|$src_dir/.spotify-wrapped|$dest_dir/.spotify-wrapped|g" "$dest_dir/spotify"
    printf '%s\n' "$src_pkg" >"$stamp"
}

# The colour of outlines: the theme's own border colour if it names one (the same
# one the window border and the bar's panels use), otherwise the focused-window
# colour of the bar.
outline_color() {
    local v
    v="$(cat "$cache/border-override" 2>/dev/null || true)"
    case "$v" in
        [0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]) printf '%s' "$v"; return 0 ;;
    esac
    theme_var focus "$(theme_var accent 7aa2f7)"
}

# A grey of the theme background's lightness, made lighter by $2 per cent (0-100).
# Greys come from white and black, never from the theme's tinted text colour, so
# nothing reads as a dim version of the accent.
neutral() {
    local bg="$1" pct="$2" r g b l v
    r=$((16#${bg:0:2})); g=$((16#${bg:2:2})); b=$((16#${bg:4:2}))
    l=$(((2126 * r + 7152 * g + 722 * b + 5000) / 10000))
    v=$((l + (255 - l) * pct / 100))
    printf '%02x%02x%02x' "$v" "$v" "$v"
}

# Black and neutral grey surfaces, the theme's outline colour as the accent (it is
# used for outlines and small marks; the user.css keeps it off big fills).
write_colors() {
    mkdir -p "$theme_dir"
    local bg red outline
    bg="$(theme_var bg 101010)"
    red="$(theme_var red f7768e)"
    outline="$(outline_color)"

    cat >"$theme_dir/color.ini" <<EOF
[base]
main               = $(neutral "$bg" 0)
sidebar            = $(neutral "$bg" 0)
player             = $(neutral "$bg" 4)
card               = $(neutral "$bg" 4)
shadow             = $(neutral "$bg" 0)
selected-row       = $(neutral "$bg" 11)
button             = ${outline}
button-active      = ${outline}
button-disabled    = $(neutral "$bg" 36)
tab-active         = ${outline}
notification       = ${outline}
notification-error = ${red}
misc               = ${outline}
text               = $(neutral "$bg" 88)
subtext            = $(neutral "$bg" 66)
EOF
}

# The outline colour and corner radius for user.css (the radius is the UI corner
# radius setting, so square corners stay square).
theme_block() {
    local r
    r="$(cache_value radius-ui 9)"
    case "$r" in '' | *[!0-9]*) r=9 ;; esac
    [ "$r" -gt 10 ] && r=10
    cat <<EOF
/* pwnbox-theme-start */
:root {
  --pwnbox-outline: #$(outline_color) !important;
  --pwnbox-radius: ${r}px !important;
}
/* pwnbox-theme-end */
EOF
}

fonts_block() {
    local ui app uisize spotsize
    ui="$(cache_value font-ui Manrope)"
    # Spotify is not a code tool: its monospace text uses the desktop font.
    app="$(cache_value font-desk "Berkeley Mono")"
    uisize="$(cache_value font-size-ui 11)"
    case "$uisize" in '' | *[!0-9]*) uisize=11 ;; esac
    spotsize=$((uisize + 5))
    cat <<EOF
/* pwnbox-fonts-start */
:root {
  --encore-body-font-stack: "${ui}", sans-serif !important;
  --encore-title-font-stack: "${ui}", sans-serif !important;
  --encore-code-font-stack: "${app}", monospace !important;
  --pwnbox-font-ui: "${ui}";
  --pwnbox-font-app: "${app}";
}
body, button, input, select, textarea, [role="textbox"] {
  font-family: "${ui}", sans-serif !important;
}
code, kbd, pre, samp {
  font-family: "${app}", monospace !important;
}
html {
  font-size: ${spotsize}px !important;
}
/* pwnbox-fonts-end */
EOF
}

write_user_css() {
    [ -f "$base_css" ] || return 0
    mkdir -p "$theme_dir"
    local tmp="$theme_dir/.user.css.pwnbox-tmp"
    {
        cat "$base_css"
        printf '\n'
        theme_block
        printf '\n'
        fonts_block
    } >"$tmp" 2>/dev/null || {
        rm -f "$tmp"
        return 1
    }
    if [ -L "$user_css" ]; then
        rm -f "$user_css" 2>/dev/null || true
    fi
    if ! cmp -s "$tmp" "$user_css" 2>/dev/null; then
        cat "$tmp" >"$user_css"
    fi
    rm -f "$tmp"
}

configure() {
    mkdir -p "$cfg_dir" "$(dirname "$prefs")"
    [ -f "$prefs" ] || : >"$prefs"
    spicetify config spotify_path "$dest_dir" >/dev/null 2>&1 || true
    spicetify config prefs_path "$prefs" >/dev/null 2>&1 || true
    spicetify config current_theme pwnbox >/dev/null 2>&1 || true
    spicetify config color_scheme base >/dev/null 2>&1 || true
    spicetify config replace_colors 1 >/dev/null 2>&1 || true
    spicetify config inject_css 1 >/dev/null 2>&1 || true
    spicetify config inject_theme_js 0 >/dev/null 2>&1 || true
    spicetify config overwrite_assets 0 >/dev/null 2>&1 || true
    spicetify config spotify_launch_flags \
        "--remote-debugging-port=$debug_port --remote-allow-origins=*" >/dev/null 2>&1 || true
}

spotify_running() { pgrep -f "$dest_dir" >/dev/null 2>&1; }

debugger_up() {
    (exec 3<>"/dev/tcp/127.0.0.1/$debug_port") 2>/dev/null || return 1
    return 0
}

live_inject() {
    command -v node >/dev/null 2>&1 || return 1
    [ -f "$live_js" ] || return 1
    [ -f "$user_css" ] || return 1
    [ -f "$theme_dir/color.ini" ] || return 1
    debugger_up || return 1
    node "$live_js" "$user_css" "$theme_dir/color.ini" >/dev/null 2>&1
}

apply_theme() {
    have spicetify || {
        echo "pwnbox-spotify: spicetify not found" >&2
        return 1
    }
    ensure_copy
    configure
    write_colors
    write_user_css

    if live_inject; then
        return 0
    fi

    if [ -f "$dest_root/.applied" ]; then
        spicetify --no-restart apply >/dev/null 2>&1 || true
    elif spicetify --no-restart backup apply >/dev/null 2>&1; then
        touch "$dest_root/.applied"
    fi
}

launch() {
    ensure_copy
    if have spicetify; then
        if [ -f "$dest_root/.applied" ]; then
            write_colors
            write_user_css
        else
            apply_theme >/dev/null 2>&1 || true
        fi
        ( sleep 4; live_inject ) >/dev/null 2>&1 &
    fi
    exec "$dest_dir/spotify" "${debug_flags[@]}" "$@"
}

case "${1:-apply}" in
    apply) apply_theme ;;
    ensure) ensure_copy ;;
    colors) write_colors ;;
    fonts) write_user_css ;;
    inject) live_inject ;;
    launch)
        shift || true
        launch "$@"
        ;;
    *)
        echo "usage: pwnbox-spotify {apply|ensure|colors|fonts|inject|launch [args...]}" >&2
        exit 2
        ;;
esac
