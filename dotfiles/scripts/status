#!/usr/bin/env sh
# One line of system numbers for the bar. Runs every few seconds, so it is one
# df plus one awk over /proc: no sleep, no per-value subshells.
set -u

runtime="${XDG_RUNTIME_DIR:-/tmp}"
net_state="$runtime/pwnbox-status.net"
df_out="$runtime/pwnbox-status.df"

df -Pk / >"$df_out" 2>/dev/null || : >"$df_out"

# The previous sample (network counters, uptime, cpu jiffies) is only there from
# the second run on; awk is told whether to expect it.
have=0
[ -f "$net_state" ] && have=1
set -- "$df_out" /proc/stat /proc/meminfo /proc/net/dev /proc/loadavg /proc/uptime \
    /proc/sys/kernel/osrelease
[ "$have" -eq 1 ] && set -- "$@" "$net_state"

awk -v state="$net_state" -v dff="$df_out" -v have="$have" '
function human_kib(k,   b, u, i) {
    b = k * 1024
    split("B KiB MiB GiB TiB", u, " ")
    i = 1
    while (b >= 1024 && i < 5) { b /= 1024; i++ }
    return sprintf((i >= 3 ? "%.1f%s" : "%.0f%s"), b, u[i])
}
function human_rate(b,   u, i) {
    split("B/s KiB/s MiB/s GiB/s", u, " ")
    i = 1
    while (b >= 1024 && i < 4) { b /= 1024; i++ }
    return sprintf((i >= 3 ? "%.1f%s" : "%.0f%s"), b, u[i])
}
FILENAME == dff && FNR == 2 { disk_used_k = $3; disk_total_k = $2; next }
FILENAME == "/proc/stat" && $1 == "cpu" {
    for (i = 2; i <= NF; i++) total += $i
    busy = total - $5 - $6
    next
}
FILENAME == "/proc/meminfo" {
    if ($1 == "MemTotal:") mem_total_k = $2
    else if ($1 == "MemAvailable:") mem_avail_k = $2
    else if ($1 == "SwapTotal:") swap_total_k = $2
    else if ($1 == "SwapFree:") swap_free_k = $2
    next
}
FILENAME == "/proc/net/dev" {
    if (index($0, ":") == 0) next
    split($0, half, ":")
    iface = half[1]; gsub(/[ \t]/, "", iface)
    if (iface == "lo") next
    split(half[2], f, " ")
    rx += f[1]; tx += f[9]
    next
}
FILENAME == "/proc/loadavg" { load = $1; next }
FILENAME == "/proc/uptime" { up_now = $1; next }
FILENAME == "/proc/sys/kernel/osrelease" { kernel = $1; next }
# An older format, a truncated file or an empty one all count as no previous
# sample. An empty file matches no record at all, hence the flag over NF alone.
FILENAME == state {
    if (NF >= 5) { prx = $1; ptx = $2; pup = $3; pbusy = $4; ptotal = $5; got = 1 }
    next
}
END {
    if (!got) have = 0
    # cpu: against the previous tick, or the since-boot average on the first run
    if (have == 1 && total > ptotal) {
        dt = total - ptotal
        cpu = int(((busy - pbusy) * 100 + dt / 2) / dt)
    } else if (total > 0) {
        cpu = int((busy * 100 + total / 2) / total)
    } else cpu = 0
    if (cpu < 0) cpu = 0
    if (cpu > 100) cpu = 100

    if (mem_total_k <= 0) mem_total_k = 1
    mem_used_k = mem_total_k - mem_avail_k
    mem = int(mem_used_k * 100 / mem_total_k)
    swap_used_k = swap_total_k - swap_free_k
    swap = swap_total_k > 0 ? int(swap_used_k * 100 / swap_total_k) : 0

    if (disk_total_k <= 0) disk_total_k = 1
    disk = int(disk_used_k * 100 / disk_total_k)

    # /proc/uptime is monotonic, so it cannot jump the way a wall clock can
    d = up_now - pup
    if (have != 1 || d <= 0) { up_bps = 0; down_bps = 0 }
    else {
        up_bps = int((tx - ptx) / d)
        down_bps = int((rx - prx) / d)
        if (up_bps < 0) up_bps = 0
        if (down_bps < 0) down_bps = 0
    }

    secs = int(up_now)
    days = int(secs / 86400)
    hours = int((secs % 86400) / 3600)
    mins = int((secs % 3600) / 60)
    if (days > 0) uptime = sprintf("%dd %dh", days, hours)
    else if (hours > 0) uptime = sprintf("%dh %dm", hours, mins)
    else uptime = sprintf("%dm", mins)

    printf "cpu=%s mem=%s swap=%s disk=%s up=%s down=%s load=%s uptime=%s kernel=%s mem_used=%s mem_total=%s swap_used=%s swap_total=%s disk_used=%s disk_total=%s\n", \
        cpu, mem, swap, disk, human_rate(up_bps), human_rate(down_bps), \
        load, uptime, kernel, \
        human_kib(mem_used_k), human_kib(mem_total_k), \
        human_kib(swap_used_k), human_kib(swap_total_k), \
        human_kib(disk_used_k), human_kib(disk_total_k)

    printf "%d %d %s %d %d\n", rx, tx, up_now, busy, total > state
}
' "$@"
