+static int handle_vmcall_ud(struct kvm_vcpu *vcpu)
+{
+	/* Bare metal raises #UD on guest VMCALL; mimic it for userspace. */
+	if (vmx_get_cpl(vcpu) != 0) {
+		kvm_queue_exception(vcpu, UD_VECTOR);
+		return 1;
+	}
+	return kvm_emulate_hypercall(vcpu);
+}
